{
  "name": "@cello-protocol/cli",
  "version": "0.0.314",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc",
    "check": "./scripts/check-protocol-copy.sh && pnpm run test && pnpm run lint && pnpm run typecheck",
    "test:live": "./scripts/live-test.sh",
    "test:install": "./scripts/install-test.sh",
    "prepare": "test ! -f scripts/prepare.sh || sh scripts/prepare.sh"
  },
  "exports": {
    "./operations": { "types": "./dist/ipc/operations.d.ts", "default": "./dist/ipc/operations.js" },
    "./ipc-client": { "types": "./dist/ipc/client.d.ts", "default": "./dist/ipc/client.js" },
    "./mcp-tools": { "types": "./dist/mcp-tools.d.ts", "default": "./dist/mcp-tools.js" },
    "./paths": { "types": "./dist/daemon/paths.d.ts", "default": "./dist/daemon/paths.js" }
  },
  "files": [
    "dist",
    "README.md",
    ".claude-plugin",
    "plugins",
    "hermes"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "@noble/curves": "latest",
    "@noble/hashes": "latest",
    "@signalapp/sqlcipher": "latest",
    "cbor-x": "1.6.4",
    "re2-wasm": "latest",
    "ws": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/ws": "latest",
    "eslint": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest"
  },
  "bin": {
    "cello": "./dist/cli.js",
    "cello-mcp": "./dist/mcp.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@signalapp/sqlcipher"
    ]
  }
}
