{
  "name": "cello-v2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc",
    "check": "./scripts/check-protocol-copy.sh && pnpm run test && pnpm run lint && pnpm run typecheck",
    "test:live": "./scripts/live-test.sh",
    "test:install": "node --test --test-force-exit live/install.live.ts",
    "prepare": "test ! -f scripts/prepare.sh || sh scripts/prepare.sh"
  },
  "files": [
    "dist",
    "README.md",
    ".claude-plugin",
    "plugins"
  ],
  "dependencies": {
    "@noble/curves": "latest",
    "@noble/hashes": "latest",
    "@signalapp/sqlcipher": "latest",
    "ws": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest",
    "@types/ws": "latest"
  },
  "bin": {
    "cello-v2": "./dist/cli.js",
    "cello-v2-mcp": "./dist/mcp.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@signalapp/sqlcipher"
    ]
  }
}
